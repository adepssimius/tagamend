# Copy to .env.local for `npm run dev` and `npm run dev:worker`.
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgres://tagamend:tagamend@localhost:5432/tagamend

# Unset in the cluster; the in-cluster ServiceAccount is used instead.
# KUBECONFIG=~/.kube/config

TRIVY_SERVER_URL=http://localhost:4954
TRIVY_IMAGE=mirror.gcr.io/aquasec/trivy:0.76.1
SCANNER=local
SCAN_NAMESPACE=tagamend
SCAN_CONCURRENCY=1
# Node names scan Jobs must not run on, comma-separated.
# SCAN_EXCLUDED_NODES=small-node
SEVERITIES=CRITICAL,HIGH,MEDIUM
REPORT_SYNC_INTERVAL=5m
TAG_SYNC_INTERVAL=6h
# Directory of per-registry credentials; see README "Registry credentials".
REGISTRY_CREDENTIALS_DIR=./secrets/registries
# Scan Jobs only (SCANNER=job): host=secret/usernameKey/passwordKey;...
# SCAN_REGISTRY_SECRETS=ghcr.io=ghcr-registry/GHCR_USERNAME/GHCR_TOKEN;index.docker.io=dockerhub-registry/DOCKERHUB_USERNAME/DOCKERHUB_TOKEN

OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=tagamend
OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_GROUPS=admins
AUTH_SECRET=change-me-to-32-random-bytes
AUTH_URL=http://localhost:3000

# Development only: skip OIDC and sign every request in as this user.
# Refused when NODE_ENV=production.
# AUTH_DEV_USER=dev

# GitOps PRs: unset GITOPS_REPO to turn the feature off. The worker alone needs
# the token: a fine-grained PAT with Contents and Pull requests read/write on
# that repo.
# GITOPS_REPO=owner/k8s-infra
# GITOPS_BRANCH=main
# GITHUB_TOKEN=
# APP_URL=http://localhost:3000
