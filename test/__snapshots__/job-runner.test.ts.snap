// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`scan Job spec > builds the Job 1`] = `
{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "annotations": {
      "tagamend.io/image": "index.docker.io/library/alpine@sha256:02bb6f428431fbc2809c5d1b41eab5a68350194fb508869a33cb1af4444c9b11",
    },
    "labels": {
      "app.kubernetes.io/managed-by": "tagamend",
      "app.kubernetes.io/name": "tagamend-scan",
      "tagamend.io/scan-id": "42",
    },
    "name": "tagamend-scan-42-abcdef",
    "namespace": "tagamend",
  },
  "spec": {
    "activeDeadlineSeconds": 600,
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "tagamend",
          "app.kubernetes.io/name": "tagamend-scan",
          "tagamend.io/scan-id": "42",
        },
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "NotIn",
                      "values": [
                        "small-node",
                      ],
                    },
                  ],
                },
              ],
            },
          },
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "image",
              "--server",
              "http://trivy-service.trivy-system:4954",
              "--format",
              "json",
              "--quiet",
              "--severity",
              "CRITICAL,HIGH,MEDIUM",
              "--platform",
              "linux/amd64",
              "--scanners",
              "vuln",
              "index.docker.io/library/alpine@sha256:02bb6f428431fbc2809c5d1b41eab5a68350194fb508869a33cb1af4444c9b11",
            ],
            "command": [
              "trivy",
            ],
            "env": [
              {
                "name": "HOME",
                "value": "/tmp",
              },
              {
                "name": "TRIVY_CACHE_DIR",
                "value": "/tmp/trivy",
              },
              {
                "name": "TRIVY_TIMEOUT",
                "value": "540s",
              },
              {
                "name": "TRIVY_LIST_ALL_PKGS",
                "value": "false",
              },
              {
                "name": "TRIVY_USERNAME",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "username",
                    "name": "dockerhub",
                  },
                },
              },
              {
                "name": "TRIVY_PASSWORD",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "password",
                    "name": "dockerhub",
                  },
                },
              },
            ],
            "image": "mirror.gcr.io/aquasec/trivy:0.76.1",
            "name": "trivy",
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "1Gi",
              },
              "requests": {
                "cpu": "100m",
                "memory": "256Mi",
              },
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL",
                ],
              },
              "privileged": false,
              "readOnlyRootFilesystem": true,
            },
            "volumeMounts": [
              {
                "mountPath": "/tmp",
                "name": "tmp",
              },
            ],
          },
        ],
        "enableServiceLinks": false,
        "restartPolicy": "Never",
        "securityContext": {
          "runAsGroup": 65534,
          "runAsNonRoot": true,
          "runAsUser": 65534,
          "seccompProfile": {
            "type": "RuntimeDefault",
          },
        },
        "volumes": [
          {
            "emptyDir": {
              "sizeLimit": "2Gi",
            },
            "name": "tmp",
          },
        ],
      },
    },
    "ttlSecondsAfterFinished": 3600,
  },
}
`;
